+package player
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	"io"
+	"net"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// These fixtures exercise SwitchingAudioSource itself, including promotion in Read.
+type taggedReader interface {
+	ReadTagged([]float32) (int, uint64, uint64, string, string, error)
+}
+type sentinel struct {
+	value    float32
+	eof      bool
+	fail     bool
+	identity string
+}
+
+func (s *sentinel) Read(p []float32) (int, error) {
+	p[0], p[1] = s.value, s.value
+	if s.eof {
+		return 2, io.EOF
+	}
+	return 2, nil
+}
+func (s *sentinel) SetPositionMs(int64) error {
+	if s.fail {
+		return errors.New("seek failure")
+	}
+	s.value = 9
+	return nil
+}
+func (*sentinel) PositionMs() int64        { return 0 }
+func (s *sentinel) FramedIdentity() string { return s.identity }
+func tagged(t *testing.T, s *SwitchingAudioSource) taggedReader {
+	t.Helper()
+	r, ok := any(s).(taggedReader)
+	if !ok {
+		t.Fatal("source cannot return read-coupled generation; buffered old samples are unidentifiable")
+	}
+	return r
+}
+func TestFramedOldTailPromotionAndAcknowledgement(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	a := &sentinel{value: 1, eof: true, identity: `{"uri":"a"}`}
+	b := &sentinel{value: 2, identity: `{"uri":"b"}`}
+	s.SetPrimary(a)
+	s.SetSecondary(b)
+	r := tagged(t, s)
+	p := make([]float32, 2)
+	n, g, o, id, reason, e := r.ReadTagged(p)
+	if n != 2 || g != 1 || o != 0 || id != a.identity || reason != "source" || e != nil || p[0] != 1 {
+		t.Fatalf("old tail mislabeled: %d %d %d %s %s %v %v", n, g, o, id, reason, e, p)
+	}
+	n, g, o, id, reason, e = r.ReadTagged(p)
+	if n != 2 || g != 2 || o != 0 || id != b.identity || reason != "prefetch" || e != nil || p[0] != 2 {
+		t.Fatalf("promotion: %d %d %d %s %s %v %v", n, g, o, id, reason, e, p)
+	}
+	s.SetPrimary(b)
+	_, g, o, _, _, _ = r.ReadTagged(p)
+	if g != 2 || o != 1 {
+		t.Fatalf("duplicate acknowledgement reset timeline: gen=%d offset=%d", g, o)
+	}
+}
+func TestFramedSeekAndFailure(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	a := &sentinel{value: 1, identity: `{"uri":"a"}`}
+	s.SetPrimary(a)
+	r := tagged(t, s)
+	p := make([]float32, 2)
+	r.ReadTagged(p)
+	if e := s.SetPositionMs(123); e != nil {
+		t.Fatal(e)
+	}
+	_, g, o, _, reason, _ := r.ReadTagged(p)
+	if g != 2 || o != 0 || reason != "seek" || p[0] != 9 {
+		t.Fatalf("seek mislabeled: %d %d %s %v", g, o, reason, p)
+	}
+	a.fail = true
+	if s.SetPositionMs(456) == nil {
+		t.Fatal("expected failed seek")
+	}
+	_, g, o, _, _, _ = r.ReadTagged(p)
+	if g != 2 || o != 1 {
+		t.Fatalf("failed seek changed generation: %d %d", g, o)
+	}
+}
+func TestFramedRejectsCrossfade(t *testing.T) {
+	s := NewSwitchingAudioSource(100)
+	s.SetPrimary(&sentinel{})
+	_, _, _, _, _, e := tagged(t, s).ReadTagged(make([]float32, 2))
+	if e == nil {
+		t.Fatal("crossfade must not carry a single-track tag")
+	}
+}
+func TestFramedStateDoesNotAdvancePausedSeek(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	a := &sentinel{value: 1, identity: `{"uri":"a"}`}
+	s.SetPrimary(a)
+	s.SetPositionMs(123)
+	r, ok := any(s).(interface {
+		FramedState() (uint64, uint64, string, string)
+	})
+	if !ok {
+		t.Fatal("paused seek generation unavailable without consuming PCM")
+	}
+	g, o, id, reason := r.FramedState()
+	if g != 2 || o != 0 || id != a.identity || reason != "seek" {
+		t.Fatalf("state %d %d %s %s", g, o, id, reason)
+	}
+}
+func TestFramedPlayerDisconnectReopensSocketAndNonce(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	p, e := NewPlayer(&Options{Log: &librespot.NullLogger{}, AudioBackend: "framed", AudioOutputPipe: path, ExternalVolume: true, VolumeUpdate: make(chan float32, 1)})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer p.Close()
+	nonce := func(c net.Conn) string {
+		t.Helper()
+		c.SetDeadline(time.Now().Add(time.Second))
+		if _, e := c.Write([]byte{1}); e != nil {
+			t.Fatal(e)
+		}
+		var size uint32
+		if e = binary.Read(c, binary.BigEndian, &size); e != nil {
+			t.Fatal(e)
+		}
+		if size > 32768 {
+			t.Fatal("oversized record")
+		}
+		b := make([]byte, size)
+		if _, e = io.ReadFull(c, b); e != nil {
+			t.Fatal(e)
+		}
+		var r struct{ Nonce string }
+		if e = json.Unmarshal(b, &r); e != nil {
+			t.Fatal(e)
+		}
+		return r.Nonce
+	}
+	if e = p.SetPrimaryStream(&sentinel{value: 1, identity: `{"uri":"a"}`}, false, false); e != nil {
+		t.Fatal(e)
+	}
+	c, e := l.Accept()
+	if e != nil {
+		t.Fatal(e)
+	}
+	first := nonce(c)
+	c.Close()
+	deadline := time.After(time.Second)
+	stopped := false
+	for !stopped {
+		select {
+		case event := <-p.Receive():
+			stopped = event.Type == EventTypeStop && event.Err != nil
+		case <-deadline:
+			t.Fatal("player retained dead framed output after peer EOF")
+		}
+	}
+	if e = p.SetPrimaryStream(&sentinel{value: 2, identity: `{"uri":"b"}`}, false, true); e != nil {
+		t.Fatalf("next admitted source did not reopen: %v", e)
+	}
+	l.(*net.UnixListener).SetDeadline(time.Now().Add(time.Second))
+	next, e := l.Accept()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer next.Close()
+	if got := nonce(next); got == first || len(got) != 32 {
+		t.Fatalf("reused output nonce %q", got)
+	}
+}
+func TestFramedAtomicBorrowedSeekBeforeAndAfterPromotion(t *testing.T) {
+	for _, promoted := range []bool{false, true} {
+		t.Run(fmt.Sprint(promoted), func(t *testing.T) {
+			s := NewSwitchingAudioSource(0)
+			s.SetPrimary(&sentinel{value: 1, eof: true, identity: `{"uri":"old"}`})
+			next := &sentinel{value: 2, eof: true, identity: `{"uri":"next"}`}
+			s.SetSecondary(next)
+			if promoted {
+				s.ReadTagged(make([]float32, 2))
+			}
+			before, _, _, _ := s.FramedState()
+			seeker, ok := any(s).(interface {
+				SetPrimaryAt(context.Context, librespot.AudioSource, int64) error
+			})
+			if !ok {
+				t.Fatal("borrowed seek cannot be installed atomically under read/generation lock")
+			}
+			if e := seeker.SetPrimaryAt(context.Background(), next, 123); e != nil {
+				t.Fatal(e)
+			}
+			g, off, _, reason := s.FramedState()
+			if g != before+1 || off != 0 || reason != "seek" {
+				t.Fatalf("seek boundary %d %d %s", g, off, reason)
+			}
+			buf := make([]float32, 2)
+			_, readGen, _, _, _, e := s.ReadTagged(buf)
+			after, _, _, _ := s.FramedState()
+			if readGen != g || after != g || e != io.EOF || buf[0] != 9 {
+				t.Fatalf("seek tail/promotion %d %d %v %v", readGen, after, e, buf)
+			}
+		})
+	}
+}
+func TestFramedBorrowedSeekClearsPriorEOFNotice(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	s.SetPrimary(&sentinel{value: 1, eof: true, identity: `{"uri":"old"}`})
+	next := &sentinel{value: 2, identity: `{"uri":"next"}`}
+	s.SetSecondary(next)
+	s.ReadTagged(make([]float32, 2))
+	if e := s.SetPrimaryAt(context.Background(), next, 123); e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case <-s.Done():
+		t.Fatal("old EOF notification survived acknowledged borrowed seek")
+	default:
+	}
+}
