diff --git a/daemon/framed_admission.go b/daemon/framed_admission.go
new file mode 100644
index 0000000..9572f96
--- /dev/null
+++ b/daemon/framed_admission.go
@@ -0,0 +1,58 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/devgianlu/go-librespot/dealer"
+	"io"
+	"net"
+	"time"
+)
+
+// Admission precedes asynchronous load. Grants never appear in logs or state.
+func (p *AppPlayer) admitNative(req dealer.RequestPayload, retain bool) (bool, error) {
+	if p.app.cfg == nil || p.app.cfg.AudioBackend != "framed" {
+		return retain, nil
+	}
+	reject := errors.New("framed native admission unavailable")
+	if req.ReceivedRawNS <= 0 || p.app.cfg.FramedInstance == "" || p.app.cfg.FramedAdmissionSocket == "" {
+		return false, reject
+	}
+	ctx, cancel := context.WithTimeout(p.ctx, 500*time.Millisecond)
+	defer cancel()
+	conn, err := (&net.Dialer{}).DialContext(ctx, "unix", p.app.cfg.FramedAdmissionSocket)
+	if err != nil {
+		return false, reject
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stop()
+	conn.SetDeadline(time.Now().Add(500 * time.Millisecond))
+	request := struct {
+		Instance string
+		Sequence uint64
+		Received int64
+		Retain   string
+	}{p.app.cfg.FramedInstance, p.app.framedSequence.Add(1), req.ReceivedRawNS, ""}
+	if retain {
+		request.Retain = p.framedGrant
+	}
+	if json.NewEncoder(conn).Encode(request) != nil {
+		return false, reject
+	}
+	var reply struct {
+		Grant    string
+		Retained bool
+	}
+	d := json.NewDecoder(io.LimitReader(conn, 256))
+	d.DisallowUnknownFields()
+	if d.Decode(&reply) != nil || len(reply.Grant) != 32 {
+		return false, reject
+	}
+	p.framedGrant = reply.Grant
+	if !reply.Retained && p.player != nil {
+		p.clearUpcoming()
+	}
+	return reply.Retained, nil
+}
diff --git a/daemon/framed_test.go b/daemon/framed_test.go
new file mode 100644
index 0000000..2828ded
--- /dev/null
+++ b/daemon/framed_test.go
@@ -0,0 +1,281 @@
+//go:build test_unit
+
+package daemon
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/dealer"
+	"github.com/devgianlu/go-librespot/player"
+	metadatapb "github.com/devgianlu/go-librespot/proto/spotify/metadata"
+	"io"
+	"math"
+	"net"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type frameTestSource struct {
+	cancel context.CancelFunc
+	closed int
+}
+
+func (*frameTestSource) Read(p []float32) (int, error) { return 0, nil }
+func (s *frameTestSource) SetPositionMs(int64) error {
+	if s.cancel != nil {
+		s.cancel()
+	}
+	return nil
+}
+func (s *frameTestSource) Close() error    { s.closed++; return nil }
+func (*frameTestSource) PositionMs() int64 { return 0 }
+func frameTestStream() *player.Stream {
+	name := "Title"
+	duration := int32(1000)
+	return &player.Stream{RequestedId: librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, make([]byte, 16)), Source: &frameTestSource{}, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Name: &name, Duration: &duration})}
+}
+func TestFramedPrefetchIdentityBeforeInstallation(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	s := frameTestStream()
+	p.commitPrefetch(s, s.Source)
+	if _, ok := p.secondarySource.(interface{ FramedIdentity() string }); !ok {
+		t.Fatal("prefetch installed source without immutable framed identity")
+	}
+}
+func TestFramedCanceledFetchCannotInstall(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	s := frameTestStream()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, _, e := p.fetchTrack(ctx, s.RequestedId, fetchTrackOpts{prefetchedStream: s, fromStart: true})
+	if !errors.Is(e, context.Canceled) {
+		t.Fatalf("canceled loader reached player: %v", e)
+	}
+}
+
+func TestCanceledBorrowedPrefetchIsNotClosed(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "pipe"}
+	s := frameTestStream()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	src := s.Source.(*frameTestSource)
+	src.cancel = cancel
+	_, _, e := p.fetchTrack(ctx, s.RequestedId, fetchTrackOpts{prefetchedStream: s, fromStart: false})
+	if !errors.Is(e, context.Canceled) {
+		t.Fatal(e)
+	}
+	if src.closed != 0 {
+		t.Fatal("canceled loader closed player-owned prefetched source")
+	}
+}
+
+type borrowedPCM struct {
+	value         float32
+	seeks, closed int
+}
+
+func (s *borrowedPCM) Read(p []float32) (int, error) { p[0], p[1] = s.value, s.value; return 2, io.EOF }
+func (s *borrowedPCM) SetPositionMs(int64) error     { s.seeks++; s.value = 9; return nil }
+func (s *borrowedPCM) PositionMs() int64             { return 0 }
+func (s *borrowedPCM) Close() error                  { s.closed++; return nil }
+
+type fetchedInstaller interface {
+	installFetchedSource(context.Context, *player.Stream, librespot.AudioSource, fetchTrackOpts) error
+}
+
+func TestFramedDaemonBorrowedSeekBeforeAndAfterPromotion(t *testing.T) {
+	for _, promoted := range []bool{false, true} {
+		t.Run(fmt.Sprint(promoted), func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "pcm.sock")
+			listener, e := net.Listen("unix", path)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer listener.Close()
+			listener.(*net.UnixListener).SetDeadline(time.Now().Add(2 * time.Second))
+			pl, e := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "framed", AudioOutputPipe: path, ExternalVolume: true, VolumeUpdate: make(chan float32, 1)})
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer pl.Close()
+			p := &AppPlayer{app: &App{cfg: &Config{AudioBackend: "framed"}, log: &librespot.NullLogger{}}, player: pl}
+			install, ok := any(p).(fetchedInstaller)
+			if !ok {
+				t.Fatal("daemon has no atomic borrowed-source installation boundary")
+			}
+			old := frameTestStream()
+			old.Source = &borrowedPCM{value: 1}
+			next := frameTestStream()
+			decoder := &borrowedPCM{value: 2}
+			next.Source = decoder
+			if e = pl.SetPrimaryStream(old.FramedSource(old.Source), false, false); e != nil {
+				t.Fatal(e)
+			}
+			peer, e := listener.Accept()
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer peer.Close()
+			p.commitPrefetch(next, next.Source)
+			type response struct {
+				Generation, Offset          uint64
+				Reason, Transport, Terminal string
+				PCM                         []byte
+			}
+			read := func(credit byte) response {
+				t.Helper()
+				peer.SetDeadline(time.Now().Add(time.Second))
+				if _, e = peer.Write([]byte{credit}); e != nil {
+					t.Fatal(e)
+				}
+				var n uint32
+				if e = binary.Read(peer, binary.BigEndian, &n); e != nil {
+					t.Fatal(e)
+				}
+				if n > 32768 {
+					t.Fatal("oversized record")
+				}
+				b := make([]byte, n)
+				if _, e = io.ReadFull(peer, b); e != nil {
+					t.Fatal(e)
+				}
+				var r response
+				if e = json.Unmarshal(b, &r); e != nil {
+					t.Fatal(e)
+				}
+				return r
+			}
+			if promoted {
+				r := read(1)
+				if binary.LittleEndian.Uint32(r.PCM) != math.Float32bits(1) {
+					t.Fatal("wrong old tail")
+				}
+			}
+			before := read(2).Generation
+			if e = install.installFetchedSource(context.Background(), next, next.Source, fetchTrackOpts{prefetchedStream: next, prefetchedSource: p.secondarySource, position: 100, paused: true}); e != nil {
+				t.Fatal(e)
+			}
+			state := read(2)
+			if state.Generation != before+1 || state.Offset != 0 || state.Reason != "seek" || state.Transport != "paused" || decoder.seeks != 1 {
+				t.Fatalf("paused borrowed seek %+v; seeks=%d", state, decoder.seeks)
+			}
+			if r := read(1); len(r.PCM) != 0 {
+				t.Fatal("paused seek produced audio")
+			}
+			if e = pl.Play(); e != nil {
+				t.Fatal(e)
+			}
+			r := read(1)
+			if len(r.PCM) != 8 || binary.LittleEndian.Uint32(r.PCM) != math.Float32bits(9) || r.Generation != state.Generation || r.Offset != 0 || r.Terminal != "track_end" {
+				t.Fatalf("wrong new source/tail %+v", r)
+			}
+			if after := read(2); after.Generation != state.Generation || after.Reason == "prefetch" {
+				t.Fatalf("borrowed decoder promoted into itself %+v", after)
+			}
+		})
+	}
+}
+func TestFramedDaemonCanceledBorrowedInstallationDoesNotSeekOrClose(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	install, ok := any(p).(fetchedInstaller)
+	if !ok {
+		t.Fatal("daemon has no atomic borrowed-source installation boundary")
+	}
+	s := frameTestStream()
+	decoder := &borrowedPCM{value: 2}
+	s.Source = decoder
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	e := install.installFetchedSource(ctx, s, s.Source, fetchTrackOpts{prefetchedStream: s, position: 100})
+	if !errors.Is(e, context.Canceled) || decoder.seeks != 0 || decoder.closed != 0 {
+		t.Fatalf("canceled borrowed source changed: %v seeks=%d close=%d", e, decoder.seeks, decoder.closed)
+	}
+}
+
+func TestNativeFramedCommandRequiresAdmissionBeforeActive(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	req := dealer.RequestPayload{}
+	req.Command.Endpoint = "transfer"
+	if err := p.handlePlayerCommand(req); err == nil {
+		t.Fatal("native transfer became active without admission")
+	}
+}
+
+func TestNativeFramedGrantPrecedesHandlerActivationAndTagsSource(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "grant.sock")
+	listener, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer listener.Close()
+	received := make(chan struct {
+		Instance string
+		Sequence uint64
+		Received int64
+		Retain   string
+	}, 1)
+	release := make(chan struct{})
+	go func() {
+		c, e := listener.Accept()
+		if e != nil {
+			return
+		}
+		defer c.Close()
+		var r struct {
+			Instance string
+			Sequence uint64
+			Received int64
+			Retain   string
+		}
+		json.NewDecoder(c).Decode(&r)
+		received <- r
+		<-release
+		json.NewEncoder(c).Encode(map[string]any{"Grant": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "Retained": false})
+	}()
+	p := newTestAppPlayer(t)
+	p.ctx = context.Background()
+	p.app.cfg = &Config{AudioBackend: "framed", FramedInstance: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", FramedAdmissionSocket: path}
+	req := dealer.RequestPayload{ReceivedRawNS: dealer.FramedRawNow()}
+	req.Command.Endpoint = "transfer"
+	done := make(chan error, 1)
+	go func() { done <- p.handlePlayerCommand(req) }()
+	var marker int64
+	select {
+	case r := <-received:
+		marker = r.Received
+		if r.Instance != p.app.cfg.FramedInstance || r.Sequence != 1 || r.Retain != "" {
+			t.Fatal("incorrect native command authority")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("handler did not request grant")
+	}
+	select {
+	case e := <-done:
+		t.Fatalf("handler activated before grant: %v", e)
+	default:
+	}
+	if marker != req.ReceivedRawNS {
+		t.Fatal("receive timestamp replaced after command queue")
+	}
+	close(release)
+	if e = <-done; e != nil {
+		t.Fatal(e)
+	}
+	stream := frameTestStream()
+	stream.FramedGrant, stream.FramedInstance = p.framedGrant, p.app.cfg.FramedInstance
+	var fields map[string]string
+	json.Unmarshal([]byte(stream.FramedSource(stream.Source).(interface{ FramedIdentity() string }).FramedIdentity()), &fields)
+	if fields["admission"] != p.framedGrant || fields["instance"] != p.app.cfg.FramedInstance {
+		t.Fatal("source lost admission authority")
+	}
+}
