+func (s *SwitchingAudioSource) SetPrimaryAt(ctx context.Context, source librespot.AudioSource, position int64) error {
+	s.cond.L.Lock()
+	defer s.cond.L.Unlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if s.crossfadeSamples != 0 {
+		return errors.New("framed seek requires crossfade disabled")
+	}
+	if err := source.SetPositionMs(position); err != nil {
+		return err
