+// FramedSource binds display identity before installation. A previously tagged
+// prefetch wrapper is returned unchanged so acknowledgement cannot reset PCM.
+func (s *Stream) FramedSource(source librespot.AudioSource) librespot.AudioSource {
+	s.framedMu.Lock()
+	defer s.framedMu.Unlock()
+	if source == s.Source && s.framedBase != nil {
+		return s.framedBase
+	}
+	if _, ok := source.(*framedSource); ok {
+		return source
+	}
+	fields := map[string]string{"admission": s.FramedGrant, "instance": s.FramedInstance, "uri": s.RequestedId.Uri(), "title": s.Media.Name()}
+	if s.Media.IsTrack() {
+		t := s.Media.Track()
+		if t.Album != nil {
+			fields["album"] = t.Album.GetName()
+		}
+		if len(t.Artist) > 0 {
+			fields["artist"] = t.Artist[0].GetName()
+		}
+	}
+	var images []*metadatapb.Image
+	if s.Media.IsTrack() {
+		album := s.Media.Track().GetAlbum()
+		images = album.GetCover()
+		if len(images) == 0 {
+			images = album.GetCoverGroup().GetImage()
+		}
+	} else if s.Media.IsEpisode() {
+		images = s.Media.Episode().GetCoverImage().GetImage()
+	}
+	for _, image := range images[:min(len(images), 16)] {
+		if len(image.GetFileId()) == 20 {
+			id := hex.EncodeToString(image.GetFileId())
+			fields["artwork_id"] = "spotify:image:" + id
+			fields["artwork_url"] = "https://i.scdn.co/image/" + id
+			break
+		}
+	}
+	for k, v := range fields {
+		v = strings.Map(func(r rune) rune {
+			if r < ' ' || r == 127 {
+				return -1
+			}
+			return r
+		}, v)
+		if len(v) > 1024 {
+			v = string([]rune(v)[:min(256, len([]rune(v)))])
+		}
+		fields[k] = v
+	}
+	identity, _ := json.Marshal(fields)
+	// Narrated/DJ source positions are not covered by the ordinary-track seam.
+	if _, ok := source.(interface{ NoCrossfade() bool }); ok {
+		identity = nil
+	}
+	wrapped := &framedSource{source, string(identity)}
+	if source == s.Source {
+		s.framedBase = wrapped
+	}
+	return wrapped
+}
+
+type framedSource struct {
+	librespot.AudioSource
+	identity string
+}
+
+func (s *framedSource) FramedIdentity() string { return s.identity }
+func (s *framedSource) Close() error {
+	switch c := s.AudioSource.(type) {
+	case interface{ Close() error }:
+		return c.Close()
+	case interface{ Close() }:
+		c.Close()
+	}
+	return nil
+}
