index 0000000..c0eacef
--- /dev/null
+++ b/daemon/framed_test.go
@@ -0,0 +1,201 @@
+//go:build test_unit
+
+package daemon
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/player"
+	metadatapb "github.com/devgianlu/go-librespot/proto/spotify/metadata"
+	"io"
+	"math"
+	"net"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type frameTestSource struct {
+	cancel context.CancelFunc
+	closed int
+}
+
+func (*frameTestSource) Read(p []float32) (int, error) { return 0, nil }
+func (s *frameTestSource) SetPositionMs(int64) error {
+	if s.cancel != nil {
+		s.cancel()
+	}
+	return nil
+}
+func (s *frameTestSource) Close() error    { s.closed++; return nil }
+func (*frameTestSource) PositionMs() int64 { return 0 }
+func frameTestStream() *player.Stream {
+	name := "Title"
+	duration := int32(1000)
+	return &player.Stream{RequestedId: librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, make([]byte, 16)), Source: &frameTestSource{}, Media: librespot.NewMediaFromTrack(&metadatapb.Track{Name: &name, Duration: &duration})}
+}
+func TestFramedPrefetchIdentityBeforeInstallation(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	s := frameTestStream()
+	p.commitPrefetch(s, s.Source)
+	if _, ok := p.secondarySource.(interface{ FramedIdentity() string }); !ok {
+		t.Fatal("prefetch installed source without immutable framed identity")
+	}
+}
+func TestFramedCanceledFetchCannotInstall(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	s := frameTestStream()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, _, e := p.fetchTrack(ctx, s.RequestedId, fetchTrackOpts{prefetchedStream: s, fromStart: true})
+	if !errors.Is(e, context.Canceled) {
+		t.Fatalf("canceled loader reached player: %v", e)
+	}
+}
+
+func TestCanceledBorrowedPrefetchIsNotClosed(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "pipe"}
+	s := frameTestStream()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	src := s.Source.(*frameTestSource)
+	src.cancel = cancel
+	_, _, e := p.fetchTrack(ctx, s.RequestedId, fetchTrackOpts{prefetchedStream: s, fromStart: false})
+	if !errors.Is(e, context.Canceled) {
+		t.Fatal(e)
+	}
+	if src.closed != 0 {
+		t.Fatal("canceled loader closed player-owned prefetched source")
+	}
+}
+
+type borrowedPCM struct {
+	value         float32
+	seeks, closed int
+}
+
+func (s *borrowedPCM) Read(p []float32) (int, error) { p[0], p[1] = s.value, s.value; return 2, io.EOF }
+func (s *borrowedPCM) SetPositionMs(int64) error     { s.seeks++; s.value = 9; return nil }
+func (s *borrowedPCM) PositionMs() int64             { return 0 }
+func (s *borrowedPCM) Close() error                  { s.closed++; return nil }
+
+type fetchedInstaller interface {
+	installFetchedSource(context.Context, *player.Stream, librespot.AudioSource, fetchTrackOpts) error
+}
+
+func TestFramedDaemonBorrowedSeekBeforeAndAfterPromotion(t *testing.T) {
+	for _, promoted := range []bool{false, true} {
+		t.Run(fmt.Sprint(promoted), func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "pcm.sock")
+			listener, e := net.Listen("unix", path)
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer listener.Close()
+			listener.(*net.UnixListener).SetDeadline(time.Now().Add(2 * time.Second))
+			pl, e := player.NewPlayer(&player.Options{Log: &librespot.NullLogger{}, AudioBackend: "framed", AudioOutputPipe: path, ExternalVolume: true, VolumeUpdate: make(chan float32, 1)})
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer pl.Close()
+			p := &AppPlayer{app: &App{cfg: &Config{AudioBackend: "framed"}, log: &librespot.NullLogger{}}, player: pl}
+			install, ok := any(p).(fetchedInstaller)
+			if !ok {
+				t.Fatal("daemon has no atomic borrowed-source installation boundary")
+			}
+			old := frameTestStream()
+			old.Source = &borrowedPCM{value: 1}
+			next := frameTestStream()
+			decoder := &borrowedPCM{value: 2}
+			next.Source = decoder
+			if e = pl.SetPrimaryStream(old.FramedSource(old.Source), false, false); e != nil {
+				t.Fatal(e)
+			}
+			peer, e := listener.Accept()
+			if e != nil {
+				t.Fatal(e)
+			}
+			defer peer.Close()
+			p.commitPrefetch(next, next.Source)
+			type response struct {
+				Generation, Offset          uint64
+				Reason, Transport, Terminal string
+				PCM                         []byte
+			}
+			read := func(credit byte) response {
+				t.Helper()
+				peer.SetDeadline(time.Now().Add(time.Second))
+				if _, e = peer.Write([]byte{credit}); e != nil {
+					t.Fatal(e)
+				}
+				var n uint32
+				if e = binary.Read(peer, binary.BigEndian, &n); e != nil {
+					t.Fatal(e)
+				}
+				if n > 32768 {
+					t.Fatal("oversized record")
+				}
+				b := make([]byte, n)
+				if _, e = io.ReadFull(peer, b); e != nil {
+					t.Fatal(e)
+				}
+				var r response
+				if e = json.Unmarshal(b, &r); e != nil {
+					t.Fatal(e)
+				}
+				return r
+			}
+			if promoted {
+				r := read(1)
+				if binary.LittleEndian.Uint32(r.PCM) != math.Float32bits(1) {
+					t.Fatal("wrong old tail")
+				}
+			}
+			before := read(2).Generation
+			if e = install.installFetchedSource(context.Background(), next, next.Source, fetchTrackOpts{prefetchedStream: next, prefetchedSource: p.secondarySource, position: 100, paused: true}); e != nil {
+				t.Fatal(e)
+			}
+			state := read(2)
+			if state.Generation != before+1 || state.Offset != 0 || state.Reason != "seek" || state.Transport != "paused" || decoder.seeks != 1 {
+				t.Fatalf("paused borrowed seek %+v; seeks=%d", state, decoder.seeks)
+			}
+			if r := read(1); len(r.PCM) != 0 {
+				t.Fatal("paused seek produced audio")
+			}
+			if e = pl.Play(); e != nil {
+				t.Fatal(e)
+			}
+			r := read(1)
+			if len(r.PCM) != 8 || binary.LittleEndian.Uint32(r.PCM) != math.Float32bits(9) || r.Generation != state.Generation || r.Offset != 0 || r.Terminal != "track_end" {
+				t.Fatalf("wrong new source/tail %+v", r)
+			}
+			if after := read(2); after.Generation != state.Generation || after.Reason == "prefetch" {
+				t.Fatalf("borrowed decoder promoted into itself %+v", after)
+			}
+		})
+	}
+}
+func TestFramedDaemonCanceledBorrowedInstallationDoesNotSeekOrClose(t *testing.T) {
+	p := newTestAppPlayer(t)
+	p.app.cfg = &Config{AudioBackend: "framed"}
+	install, ok := any(p).(fetchedInstaller)
+	if !ok {
+		t.Fatal("daemon has no atomic borrowed-source installation boundary")
+	}
+	s := frameTestStream()
+	decoder := &borrowedPCM{value: 2}
+	s.Source = decoder
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	e := install.installFetchedSource(ctx, s, s.Source, fetchTrackOpts{prefetchedStream: s, position: 100})
+	if !errors.Is(e, context.Canceled) || decoder.seeks != 0 || decoder.closed != 0 {
+		t.Fatalf("canceled borrowed source changed: %v seeks=%d close=%d", e, decoder.seeks, decoder.closed)
+	}
+}
diff --git a/output/driver-framed.go b/output/driver-framed.go
new file mode 100644
index 0000000..45ae731
--- /dev/null
+++ b/output/driver-framed.go
@@ -0,0 +1,212 @@
+package output
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net"
+	"sync"
+	"time"
+)
+
+type framedReader interface {
+	ReadTagged([]float32) (int, uint64, uint64, string, string, error)
+	FramedState() (uint64, uint64, string, string)
+}
+type framedCommand struct {
+	kind string
+	ack  chan error
+}
+type framedOutput struct {
+	conn         net.Conn
+	reader       framedReader
+	nonce        string
+	commands     chan framedCommand
+	done         chan struct{}
+	closed       chan struct{}
+	err          chan error
+	volumeUpdate chan float32
+	volumeMu     sync.Mutex
+	closeOnce    sync.Once
+}
+
+// The peer grants exactly one 20ms read with byte 1. No speculative decoder
+// reads or application queue are kept. Kernel buffering can contain only that
+// one response when a conforming peer allows only one outstanding request.
+func newFramedOutput(o *NewOutputOptions) (Output, error) {
+	r, ok := o.Reader.(framedReader)
+	if !ok || o.SampleRate != 44100 || o.ChannelCount != 2 || !o.ExternalVolume {
+		return nil, errors.New("framed output requires tagged stereo 44100 and external volume")
+	}
+	c, e := net.DialTimeout("unix", o.OutputPipe, time.Second)
+	if e != nil {
+		return nil, errors.New("framed endpoint unavailable")
+	}
+	var nonce [16]byte
+	if _, e = rand.Read(nonce[:]); e != nil {
+		c.Close()
+		return nil, e
+	}
+	f := &framedOutput{conn: c, reader: r, nonce: hex.EncodeToString(nonce[:]), commands: make(chan framedCommand), done: make(chan struct{}), closed: make(chan struct{}), err: make(chan error, 1), volumeUpdate: o.VolumeUpdate}
+	go f.run()
+	return f, nil
+}
+func (f *framedOutput) run() {
+	defer close(f.done)
+	defer f.conn.Close()
+	paused := true
+	credit := false
+	statusOnly := false
+	for {
+		select {
+		case <-f.closed:
+			return
+		default:
+		}
+		select {
+		case cmd := <-f.commands:
+			switch cmd.kind {
+			case "pause":
+				paused = true
+			case "resume":
+				paused = false
+			case "drop":
+				paused = true
+			}
+			cmd.ack <- nil
+		default:
+		}
+		if !credit {
+			f.conn.SetReadDeadline(time.Now().Add(25 * time.Millisecond))
+			var request [1]byte
+			_, e := io.ReadFull(f.conn, request[:])
+			if e != nil {
+				if n, ok := e.(net.Error); ok && n.Timeout() {
+					continue
+				}
+				select {
+				case <-f.closed:
+				default:
+					f.err <- errors.New("framed consumer disconnected")
+				}
+				return
+			}
+			if request[0] != 1 && request[0] != 2 {
+				f.err <- errors.New("invalid framed credit")
+				return
+			}
+			credit = true
+			statusOnly = request[0] == 2
+		}
+		samples := make([]float32, 1764)
+		var n int
+		var g, offset uint64
+		var identity, reason string
+		var readErr error
+		transport := "playing"
+		if paused {
+			transport = "paused"
+		}
+		if paused || statusOnly {
+			g, offset, identity, reason = f.reader.FramedState()
+		} else {
+			n, g, offset, identity, reason, readErr = f.reader.ReadTagged(samples)
+		}
+
+		if n < 0 || n > len(samples) || n%2 != 0 || len(identity) > 8192 || !json.Valid([]byte(identity)) {
+			f.err <- errors.New("invalid framed source record")
+			return
+		}
+		pcm := make([]byte, 4*n)
+		for i, v := range samples[:n] {
+			if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+				f.err <- errors.New("nonfinite framed PCM")
+				return
+			}
+			binary.LittleEndian.PutUint32(pcm[i*4:], math.Float32bits(v))
+		}
+		terminal := ""
+		if errors.Is(readErr, io.EOF) {
+			terminal = "track_end"
+			paused = true
+		} else if readErr != nil {
+			terminal = "error"
+		}
+		record := struct {
+			Version            int
+			Nonce              string
+			Generation, Offset uint64
+			Identity           json.RawMessage
+			Reason             string
+			Rate, Channels     int
+			PCM                []byte
+			Terminal           string
+			Transport          string
+		}{1, f.nonce, g, offset, json.RawMessage(identity), reason, 44100, 2, pcm, terminal, transport}
+		body, e := json.Marshal(record)
+		if e != nil || len(body) > 32768 {
+			f.err <- errors.New("framed record too large")
+			return
+		}
+		packet := make([]byte, 4+len(body))
+		binary.BigEndian.PutUint32(packet, uint32(len(body)))
+		copy(packet[4:], body)
+		// No source/state mutex is held during transport writes. A control barrier
+		// waits for this one ordered record or observes the failed/closed channel.
+		f.conn.SetWriteDeadline(time.Now().Add(250 * time.Millisecond))
+		for len(packet) > 0 {
+			n, e := f.conn.Write(packet)
+			if e != nil {
+				f.err <- errors.New("framed consumer stalled or disconnected")
+				return
+			}
+			packet = packet[n:]
+		}
+		credit = false
+		if terminal == "error" {
+			f.err <- errors.New("framed decoder failed")
+			return
+		}
+	}
+}
+func (f *framedOutput) command(kind string) error {
+	cmd := framedCommand{kind, make(chan error, 1)}
+	timer := time.NewTimer(500 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case f.commands <- cmd:
+	case <-f.done:
+		return errors.New("framed output closed")
+	case <-timer.C:
+		f.Close()
+		return errors.New("framed control timed out")
+	}
+	select {
+	case e := <-cmd.ack:
+		return e
+	case <-f.done:
+		return errors.New("framed output closed")
+	case <-timer.C:
+		f.Close()
+		return errors.New("framed control timed out")
+	}
+}
+func (f *framedOutput) Pause() error            { return f.command("pause") }
+func (f *framedOutput) Resume() error           { return f.command("resume") }
+func (f *framedOutput) Drop() error             { return f.command("drop") }
+func (f *framedOutput) DelayMs() (int64, error) { return 0, nil }
+func (f *framedOutput) SetVolume(v float32) {
+	f.volumeMu.Lock()
+	defer f.volumeMu.Unlock()
+	sendVolumeUpdate(f.volumeUpdate, v)
+}
+func (f *framedOutput) Error() <-chan error { return f.err }
+func (f *framedOutput) Close() error {
+	var e error
+	f.closeOnce.Do(func() { close(f.closed); e = f.conn.Close() })
+	return e
+}
