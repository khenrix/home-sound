diff --git a/output/driver-framed.go b/output/driver-framed.go
new file mode 100644
index 0000000..5b38c78
--- /dev/null
+++ b/output/driver-framed.go
@@ -0,0 +1,212 @@
+package output
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net"
+	"sync"
+	"time"
+)
+
+type framedReader interface {
+	ReadTagged([]float32) (int, uint64, uint64, string, string, error)
+	FramedState() (uint64, uint64, string, string)
+}
+type framedCommand struct {
+	kind string
+	ack  chan error
+}
+type framedOutput struct {
+	conn         net.Conn
+	reader       framedReader
+	nonce        string
+	commands     chan framedCommand
+	done         chan struct{}
+	closed       chan struct{}
+	err          chan error
+	volumeUpdate chan float32
+	volumeMu     sync.Mutex
+	closeOnce    sync.Once
+}
+
+// The peer grants exactly one 20ms read with byte 1. No speculative decoder
+// reads or application queue are kept. Kernel buffering can contain only that
+// one response when a conforming peer allows only one outstanding request.
+func newFramedOutput(o *NewOutputOptions) (Output, error) {
+	r, ok := o.Reader.(framedReader)
+	if !ok || o.SampleRate != 44100 || o.ChannelCount != 2 || !o.ExternalVolume {
+		return nil, errors.New("framed output requires tagged stereo 44100 and external volume")
+	}
+	c, e := net.DialTimeout("unix", o.OutputPipe, time.Second)
+	if e != nil {
+		return nil, errors.New("framed endpoint unavailable")
+	}
+	var nonce [16]byte
+	if _, e = rand.Read(nonce[:]); e != nil {
+		c.Close()
+		return nil, e
+	}
+	f := &framedOutput{conn: c, reader: r, nonce: hex.EncodeToString(nonce[:]), commands: make(chan framedCommand), done: make(chan struct{}), closed: make(chan struct{}), err: make(chan error, 1), volumeUpdate: o.VolumeUpdate}
+	go f.run()
+	return f, nil
+}
+func (f *framedOutput) run() {
+	defer close(f.done)
+	defer f.conn.Close()
+	paused := true
+	credit := false
+	statusOnly := false
+	for {
+		select {
+		case <-f.closed:
+			return
+		default:
+		}
+		select {
+		case cmd := <-f.commands:
+			switch cmd.kind {
+			case "pause":
+				paused = true
+			case "resume":
+				paused = false
+			case "drop":
+				paused = true
+			}
+			cmd.ack <- nil
+		default:
+		}
+		if !credit {
+			f.conn.SetReadDeadline(time.Now().Add(25 * time.Millisecond))
+			var request [1]byte
+			_, e := io.ReadFull(f.conn, request[:])
+			if e != nil {
+				if n, ok := e.(net.Error); ok && n.Timeout() {
+					continue
+				}
+				select {
+				case <-f.closed:
+				default:
+					f.err <- errors.New("framed consumer disconnected")
+				}
+				return
+			}
+			if request[0] != 1 && request[0] != 2 {
+				f.err <- errors.New("invalid framed credit")
+				return
+			}
+			credit = true
+			statusOnly = request[0] == 2
+		}
+		samples := make([]float32, 1764)
+		var n int
+		var g, offset uint64
+		var identity, reason string
+		var readErr error
+		transport := "playing"
+		if paused {
+			transport = "paused"
+		}
+		if paused || statusOnly {
+			g, offset, identity, reason = f.reader.FramedState()
+		} else {
+			n, g, offset, identity, reason, readErr = f.reader.ReadTagged(samples)
+		}
+
+		if n < 0 || n > len(samples) || n%2 != 0 || len(identity) > 8192 || !json.Valid([]byte(identity)) {
+			f.err <- errors.New("invalid framed source record")
+			return
+		}
+		pcm := make([]byte, 4*n)
+		for i, v := range samples[:n] {
+			if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+				f.err <- errors.New("nonfinite framed PCM")
+				return
+			}
+			binary.LittleEndian.PutUint32(pcm[i*4:], math.Float32bits(v))
+		}
+		terminal := ""
+		if errors.Is(readErr, io.EOF) {
+			terminal = "track_end"
+			paused = true
+		} else if readErr != nil {
+			terminal = "error"
+		}
+		record := struct {
+			Version            int
+			Nonce              string
+			Generation, Offset uint64
+			Identity           json.RawMessage
+			Reason             string
+			Rate, Channels     int
+			PCM                []byte
+			Terminal           string
+			Transport          string
+		}{2, f.nonce, g, offset, json.RawMessage(identity), reason, 44100, 2, pcm, terminal, transport}
+		body, e := json.Marshal(record)
+		if e != nil || len(body) > 32768 {
+			f.err <- errors.New("framed record too large")
+			return
+		}
+		packet := make([]byte, 4+len(body))
+		binary.BigEndian.PutUint32(packet, uint32(len(body)))
+		copy(packet[4:], body)
+		// No source/state mutex is held during transport writes. A control barrier
+		// waits for this one ordered record or observes the failed/closed channel.
+		f.conn.SetWriteDeadline(time.Now().Add(250 * time.Millisecond))
+		for len(packet) > 0 {
+			n, e := f.conn.Write(packet)
+			if e != nil {
+				f.err <- errors.New("framed consumer stalled or disconnected")
+				return
+			}
+			packet = packet[n:]
+		}
+		credit = false
+		if terminal == "error" {
+			f.err <- errors.New("framed decoder failed")
+			return
+		}
+	}
+}
+func (f *framedOutput) command(kind string) error {
+	cmd := framedCommand{kind, make(chan error, 1)}
+	timer := time.NewTimer(500 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case f.commands <- cmd:
+	case <-f.done:
+		return errors.New("framed output closed")
+	case <-timer.C:
+		f.Close()
+		return errors.New("framed control timed out")
+	}
+	select {
+	case e := <-cmd.ack:
+		return e
+	case <-f.done:
+		return errors.New("framed output closed")
+	case <-timer.C:
+		f.Close()
+		return errors.New("framed control timed out")
+	}
+}
+func (f *framedOutput) Pause() error            { return f.command("pause") }
+func (f *framedOutput) Resume() error           { return f.command("resume") }
+func (f *framedOutput) Drop() error             { return f.command("drop") }
+func (f *framedOutput) DelayMs() (int64, error) { return 0, nil }
+func (f *framedOutput) SetVolume(v float32) {
+	f.volumeMu.Lock()
+	defer f.volumeMu.Unlock()
+	sendVolumeUpdate(f.volumeUpdate, v)
+}
+func (f *framedOutput) Error() <-chan error { return f.err }
+func (f *framedOutput) Close() error {
+	var e error
+	f.closeOnce.Do(func() { close(f.closed); e = f.conn.Close() })
+	return e
+}
