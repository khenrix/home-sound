+package dealer
+
+import "golang.org/x/sys/unix"
+
+// FramedRawNow shares CLOCK_MONOTONIC_RAW with the local admission controller.
+func FramedRawNow() int64 {
+	var t unix.Timespec
+	if unix.ClockGettime(unix.CLOCK_MONOTONIC_RAW, &t) != nil {
+		return 0
+	}
+	return t.Nano()
+}
