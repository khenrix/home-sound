+		t.Fatalf("framed output unavailable: %v", e)
+	}
+	defer out.Close()
+	c := <-accept
+	defer c.Close()
+	out.Resume()
+	c.SetReadDeadline(time.Now().Add(40 * time.Millisecond))
+	var one [1]byte
+	if _, e := c.Read(one[:]); e == nil {
+		t.Fatal("helper produced PCM without demand")
+	}
+	c.SetReadDeadline(time.Now().Add(time.Second))
+	c.Write([]byte{1})
+	var size uint32
+	if e = binary.Read(c, binary.BigEndian, &size); e != nil {
+		t.Fatal(e)
+	}
+	if size > 32768 {
+		t.Fatalf("unbounded record %d", size)
+	}
+	b := make([]byte, size)
+	if _, e = io.ReadFull(c, b); e != nil {
+		t.Fatal(e)
+	}
+	var r struct {
+		Version            int
+		Nonce              string
+		Generation, Offset uint64
+		PCM                []byte
+		Identity           json.RawMessage
+	}
+	if e = json.Unmarshal(b, &r); e != nil {
+		t.Fatal(e)
+	}
+	if r.Version != 2 || len(r.Nonce) != 32 || r.Generation != 1 || r.Offset != 0 || len(r.PCM) != 8 || binary.LittleEndian.Uint32(r.PCM) != 0x3e800000 {
+		t.Fatalf("wrong record: %+v", r)
+	}
+	// A consumer withholding reads must not hold Pause/Drop/Close forever.
+	c.Write([]byte{1})
+	done := make(chan struct{})
+	go func() { out.Pause(); out.Drop(); out.Close(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("blocked sink deadlocked controls")
+	}
+}
