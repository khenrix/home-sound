+++ b/player/framed_source_test.go
@@ -0,0 +1,112 @@
+package player
+
+import (
+	"errors"
+	"io"
+	"testing"
+)
+
+// These fixtures exercise SwitchingAudioSource itself, including promotion in Read.
+type taggedReader interface {
+	ReadTagged([]float32) (int, uint64, uint64, string, string, error)
+}
+type sentinel struct {
+	value    float32
+	eof      bool
+	fail     bool
+	identity string
+}
+
+func (s *sentinel) Read(p []float32) (int, error) {
+	p[0], p[1] = s.value, s.value
+	if s.eof {
+		return 2, io.EOF
+	}
+	return 2, nil
+}
+func (s *sentinel) SetPositionMs(int64) error {
+	if s.fail {
+		return errors.New("seek failure")
+	}
+	s.value = 9
+	return nil
+}
+func (*sentinel) PositionMs() int64        { return 0 }
+func (s *sentinel) FramedIdentity() string { return s.identity }
+func tagged(t *testing.T, s *SwitchingAudioSource) taggedReader {
+	t.Helper()
+	r, ok := any(s).(taggedReader)
+	if !ok {
+		t.Fatal("source cannot return read-coupled generation; buffered old samples are unidentifiable")
+	}
+	return r
+}
+func TestFramedOldTailPromotionAndAcknowledgement(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	a := &sentinel{value: 1, eof: true, identity: `{"uri":"a"}`}
+	b := &sentinel{value: 2, identity: `{"uri":"b"}`}
+	s.SetPrimary(a)
+	s.SetSecondary(b)
+	r := tagged(t, s)
+	p := make([]float32, 2)
+	n, g, o, id, reason, e := r.ReadTagged(p)
+	if n != 2 || g != 1 || o != 0 || id != a.identity || reason != "source" || e != nil || p[0] != 1 {
+		t.Fatalf("old tail mislabeled: %d %d %d %s %s %v %v", n, g, o, id, reason, e, p)
+	}
+	n, g, o, id, reason, e = r.ReadTagged(p)
+	if n != 2 || g != 2 || o != 0 || id != b.identity || reason != "prefetch" || e != nil || p[0] != 2 {
+		t.Fatalf("promotion: %d %d %d %s %s %v %v", n, g, o, id, reason, e, p)
+	}
+	s.SetPrimary(b)
+	_, g, o, _, _, _ = r.ReadTagged(p)
+	if g != 2 || o != 1 {
+		t.Fatalf("duplicate acknowledgement reset timeline: gen=%d offset=%d", g, o)
+	}
+}
+func TestFramedSeekAndFailure(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	a := &sentinel{value: 1, identity: `{"uri":"a"}`}
+	s.SetPrimary(a)
+	r := tagged(t, s)
+	p := make([]float32, 2)
+	r.ReadTagged(p)
+	if e := s.SetPositionMs(123); e != nil {
+		t.Fatal(e)
+	}
+	_, g, o, _, reason, _ := r.ReadTagged(p)
+	if g != 2 || o != 0 || reason != "seek" || p[0] != 9 {
+		t.Fatalf("seek mislabeled: %d %d %s %v", g, o, reason, p)
+	}
+	a.fail = true
+	if s.SetPositionMs(456) == nil {
+		t.Fatal("expected failed seek")
+	}
+	_, g, o, _, _, _ = r.ReadTagged(p)
+	if g != 2 || o != 1 {
+		t.Fatalf("failed seek changed generation: %d %d", g, o)
+	}
+}
+func TestFramedRejectsCrossfade(t *testing.T) {
+	s := NewSwitchingAudioSource(100)
+	s.SetPrimary(&sentinel{})
+	_, _, _, _, _, e := tagged(t, s).ReadTagged(make([]float32, 2))
+	if e == nil {
+		t.Fatal("crossfade must not carry a single-track tag")
+	}
+}
+func TestFramedStateDoesNotAdvancePausedSeek(t *testing.T) {
+	s := NewSwitchingAudioSource(0)
+	a := &sentinel{value: 1, identity: `{"uri":"a"}`}
+	s.SetPrimary(a)
+	s.SetPositionMs(123)
+	r, ok := any(s).(interface {
+		FramedState() (uint64, uint64, string, string)
+	})
+	if !ok {
+		t.Fatal("paused seek generation unavailable without consuming PCM")
+	}
+	g, o, id, reason := r.FramedState()
+	if g != 2 || o != 0 || id != a.identity || reason != "seek" {
+		t.Fatalf("state %d %d %s %s", g, o, id, reason)
+	}
+}
