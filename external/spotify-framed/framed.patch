+
+// ReadTagged captures identity and generation under the same lock as decoder
+// Read. A tail returned with EOF keeps its old tag even if readDirect promotes
+// the prefetched source before returning. Offsets count decoded stereo frames,
+// never a claimed original-track sample position after an approximate seek.
+func (s *SwitchingAudioSource) ReadTagged(p []float32) (n int, generation, offset uint64, identity, reason string, err error) {
+	s.cond.L.Lock()
+	defer s.cond.L.Unlock()
+	if s.crossfadeSamples != 0 {
+		return 0, 0, 0, "", "", errors.New("framed backend requires crossfade disabled")
+	}
+	for s.source[s.which] == nil {
+		s.cond.Wait()
+	}
+	tagged, ok := s.source[s.which].(interface{ FramedIdentity() string })
+	if !ok {
+		return 0, 0, 0, "", "", errors.New("framed source identity missing")
+	}
+	generation, offset, identity, reason = s.pcmGeneration, s.pcmOffset, tagged.FramedIdentity(), s.pcmReason
+	n, err = s.readDirect(p)
+	if n%Channels != 0 {
+		return 0, generation, offset, identity, reason, errors.New("partial stereo frame")
+	}
+	if generation == s.pcmGeneration {
+		s.pcmOffset += uint64(n / Channels)
+	}
+	return
+}
+
+// FramedState observes a paused/discontinuous source without decoding samples.
+func (s *SwitchingAudioSource) FramedState() (uint64, uint64, string, string) {
+	s.cond.L.Lock()
+	defer s.cond.L.Unlock()
+	identity := "{}"
+	if t, ok := s.source[s.which].(interface{ FramedIdentity() string }); ok {
+		identity = t.FramedIdentity()
+	}
+	return s.pcmGeneration, s.pcmOffset, identity, s.pcmReason
+}
