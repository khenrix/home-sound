+func TestFramedPlayerPausedBorrowedSeekUsesTaggedSource(t *testing.T) {
+	out := &recordingOutput{}
+	p := newTestPlayer(t, out)
+	first := &sentinel{value: 1, identity: `{"uri":"old"}`}
+	next := &sentinel{value: 2, identity: `{"uri":"next"}`}
+	if e := p.SetPrimaryStream(first, false, false); e != nil {
+		t.Fatal(e)
+	}
+	p.SetSecondaryStream(next)
+	installer, ok := any(p).(interface {
+		SetPrimaryStreamAt(context.Context, librespot.AudioSource, bool, int64) error
+	})
+	if !ok {
+		t.Fatal("player cannot route borrowed seek through locked tagged source")
