+package player
+
+import (
+	"encoding/json"
+	librespot "github.com/devgianlu/go-librespot"
+	metadatapb "github.com/devgianlu/go-librespot/proto/spotify/metadata"
+	"io"
+	"testing"
+)
+
+func TestStreamIdentityAttachedBeforePrefetch(t *testing.T) {
+	name := "Track"
+	s := &Stream{RequestedId: librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, make([]byte, 16)), Media: librespot.NewMediaFromTrack(&metadatapb.Track{Name: &name})}
+	adapter, ok := any(s).(interface {
+		FramedSource(librespot.AudioSource) librespot.AudioSource
+	})
+	if !ok {
+		t.Fatal("stream cannot attach immutable metadata before source installation")
+	}
+	original := &sentinel{value: 2}
+	wrapped := adapter.FramedSource(original)
+	id, ok := wrapped.(interface{ FramedIdentity() string })
+	if !ok {
+		t.Fatal("missing identity")
+	}
+	var m struct{ URI, Title string }
+	if json.Unmarshal([]byte(id.FramedIdentity()), &m) != nil || m.Title != "Track" || m.URI != "spotify:track:0000000000000000000000" {
+		t.Fatalf("identity %s", id.FramedIdentity())
+	}
+	if adapter.FramedSource(wrapped) != wrapped {
+		t.Fatal("prefetch acknowledgement got different source identity")
+	}
+	name = "mutated"
+	if id.FramedIdentity() == "" {
+		t.Fatal("empty metadata")
+	}
+	json.Unmarshal([]byte(id.FramedIdentity()), &m)
+	if m.Title != "Track" {
+		t.Fatal("metadata not immutable")
+	}
+}
+func TestFramedPrefetchReuseDoesNotPromoteDecoderAlias(t *testing.T) {
+	name := "Track"
+	base := &sentinel{value: 2, eof: true}
+	stream := &Stream{RequestedId: librespot.SpotifyIdFromGid(librespot.SpotifyIdTypeTrack, make([]byte, 16)), Media: librespot.NewMediaFromTrack(&metadatapb.Track{Name: &name}), Source: base}
+	s := NewSwitchingAudioSource(0)
+	s.SetPrimary(&sentinel{value: 1, identity: `{"uri":"old"}`})
+	s.SetSecondary(stream.FramedSource(base))
+	s.SetPrimary(stream.FramedSource(base))
+	_, g, _, _, _, e := s.ReadTagged(make([]float32, 2))
+	next, _, _, reason := s.FramedState()
+	if e != io.EOF || next != g {
+		t.Fatalf("borrowed decoder alias promoted again: generation %d -> %d reason %s error %v", g, next, reason, e)
+	}
+}
