+	generation := s.pcmGeneration
+	s.setPrimaryLocked(source)
+	s.pcmGeneration = generation + 1
+	s.pcmOffset = 0
+	s.pcmReason = "seek"
+	// A pending EOF belongs to the replaced timeline, not this new seek.
+	select {
+	case <-s.done:
+	default:
+	}
+	return nil
+}
