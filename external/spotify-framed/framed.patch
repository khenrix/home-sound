+func (s *framedFixture) ReadTagged(p []float32) (int, uint64, uint64, string, string, error) {
+	n, e := s.Read(p)
+	return n, 1, 0, `{"uri":"spotify:track:test","title":"Test"}`, "source", e
+}
+func TestFramedBackendPullAndBlockedClose(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	accept := make(chan net.Conn, 1)
+	go func() { c, _ := l.Accept(); accept <- c }()
+	out, e := NewOutput(&NewOutputOptions{Backend: "framed", Reader: &framedFixture{}, OutputPipe: path, SampleRate: 44100, ChannelCount: 2, ExternalVolume: true, VolumeUpdate: make(chan float32, 1)})
+	if e != nil {
+		t.Fatalf("framed output unavailable: %v", e)
+	}
+	defer out.Close()
+	c := <-accept
+	defer c.Close()
+	out.Resume()
+	c.SetReadDeadline(time.Now().Add(40 * time.Millisecond))
+	var one [1]byte
+	if _, e := c.Read(one[:]); e == nil {
+		t.Fatal("helper produced PCM without demand")
+	}
+	c.SetReadDeadline(time.Now().Add(time.Second))
+	c.Write([]byte{1})
+	var size uint32
+	if e = binary.Read(c, binary.BigEndian, &size); e != nil {
+		t.Fatal(e)
+	}
+	if size > 32768 {
+		t.Fatalf("unbounded record %d", size)
+	}
+	b := make([]byte, size)
+	if _, e = io.ReadFull(c, b); e != nil {
+		t.Fatal(e)
+	}
+	var r struct {
+		Version            int
+		Nonce              string
+		Generation, Offset uint64
+		PCM                []byte
+		Identity           json.RawMessage
+	}
+	if e = json.Unmarshal(b, &r); e != nil {
+		t.Fatal(e)
+	}
+	if r.Version != 1 || len(r.Nonce) != 32 || r.Generation != 1 || r.Offset != 0 || len(r.PCM) != 8 || binary.LittleEndian.Uint32(r.PCM) != 0x3e800000 {
+		t.Fatalf("wrong record: %+v", r)
+	}
+	// A consumer withholding reads must not hold Pause/Drop/Close forever.
+	c.Write([]byte{1})
+	done := make(chan struct{})
+	go func() { out.Pause(); out.Drop(); out.Close(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("blocked sink deadlocked controls")
+	}
+}
+func TestFramedCloseAfterPausedCreditReapsWriter(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	accept := make(chan net.Conn, 1)
+	go func() { c, _ := l.Accept(); accept <- c }()
+	out, e := newFramedOutput(&NewOutputOptions{Reader: &framedFixture{}, OutputPipe: path, SampleRate: 44100, ChannelCount: 2, ExternalVolume: true})
+	if e != nil {
+		t.Fatal(e)
+	}
+	c := <-accept
+	defer c.Close()
+	c.Write([]byte{1})
+	time.Sleep(30 * time.Millisecond)
+	out.Close()
+	select {
+	case <-out.(*framedOutput).done:
+	case <-time.After(100 * time.Millisecond):
+		t.Fatal("paused credited writer leaked after Close")
+	}
+}
+func TestFramedSubprocessBlockedSink(t *testing.T) {
+	if path := os.Getenv("FRAMED_TEST_SOCKET"); path != "" {
+		out, e := newFramedOutput(&NewOutputOptions{Reader: &largeFramedFixture{}, OutputPipe: path, SampleRate: 44100, ChannelCount: 2, ExternalVolume: true})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = out.Resume(); e != nil {
+			t.Fatal(e)
+		}
+		time.Sleep(100 * time.Millisecond)
+		start := time.Now()
+		if out.Pause() == nil {
+			t.Fatal("expected stalled transport to fail barrier")
+		}
+		_ = out.Drop()
+		out.Close()
+		if time.Since(start) > time.Second {
+			t.Fatal("controls exceeded bound")
+		}
+		select {
+		case <-out.(*framedOutput).done:
+		case <-time.After(time.Second):
+			t.Fatal("writer not reaped")
+		}
+		return
+	}
+	path := filepath.Join(t.TempDir(), "pcm.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestFramedSubprocessBlockedSink$")
+	cmd.Env = append(os.Environ(), "FRAMED_TEST_SOCKET="+path)
+	var diagnostic bytes.Buffer
+	cmd.Stderr = &diagnostic
+	cmd.Stdout = &diagnostic
+	if e = cmd.Start(); e != nil {
+		t.Fatal(e)
+	}
+	c, e := l.Accept()
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer c.Close()
+	credits := bytes.Repeat([]byte{1}, 65536)
+	c.SetWriteDeadline(time.Now().Add(time.Second))
+	_, _ = c.Write(credits)
+	if e = cmd.Wait(); e != nil {
+		t.Fatalf("subprocess %v: %s", e, &diagnostic)
+	}
+}
+func TestFramedBlockedStartupBound(t *testing.T) {
+	start := time.Now()
+	_, e := newFramedOutput(&NewOutputOptions{Reader: &framedFixture{}, OutputPipe: filepath.Join(t.TempDir(), "absent.sock"), SampleRate: 44100, ChannelCount: 2, ExternalVolume: true})
+	if e == nil || time.Since(start) > 1500*time.Millisecond {
+		t.Fatalf("startup not bounded: %v", e)
+	}
+}
+
+type largeFramedFixture struct{ framedFixture }
+
+func (s *largeFramedFixture) ReadTagged(p []float32) (int, uint64, uint64, string, string, error) {
+	return len(p), 1, 0, `{"uri":"test"}`, "source", nil
+}
+func TestFramedDropBarrierStaysPaused(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	accept := make(chan net.Conn, 1)
+	go func() { c, _ := l.Accept(); accept <- c }()
+	out, e := newFramedOutput(&NewOutputOptions{Reader: &framedFixture{}, OutputPipe: path, SampleRate: 44100, ChannelCount: 2, ExternalVolume: true})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer out.Close()
+	c := <-accept
+	defer c.Close()
+	out.Resume()
+	if e = out.Drop(); e != nil {
+		t.Fatal(e)
+	}
+	c.Write([]byte{1})
+	c.SetReadDeadline(time.Now().Add(time.Second))
+	var size uint32
+	if e = binary.Read(c, binary.BigEndian, &size); e != nil {
+		t.Fatal(e)
+	}
+	body := make([]byte, size)
+	io.ReadFull(c, body)
+	var record struct {
+		PCM       []byte
+		Transport string
+	}
+	json.Unmarshal(body, &record)
+	if len(record.PCM) != 0 || record.Transport != "paused" {
+		t.Fatal("Drop acknowledged but old source continued producing")
+	}
+	if e = out.Resume(); e != nil {
+		t.Fatal(e)
+	}
+	c.Write([]byte{1})
+	var b [1]byte
+	if _, e = c.Read(b[:]); e != nil {
+		t.Fatalf("resume failed: %v", e)
+	}
+}
+func (*framedFixture) FramedState() (uint64, uint64, string, string) {
+	return 3, 0, `{"uri":"paused"}`, "seek"
+}
+func TestFramedStatusCreditObservesPausedSeekWithoutPCM(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "pcm.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	accept := make(chan net.Conn, 1)
+	go func() { c, _ := l.Accept(); accept <- c }()
+	out, e := newFramedOutput(&NewOutputOptions{Reader: &framedFixture{}, OutputPipe: path, SampleRate: 44100, ChannelCount: 2, ExternalVolume: true})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer out.Close()
+	c := <-accept
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(time.Second))
+	c.Write([]byte{2})
+	var n uint32
+	if e = binary.Read(c, binary.BigEndian, &n); e != nil {
+		t.Fatalf("no framed paused seek state: %v", e)
+	}
+	b := make([]byte, n)
+	io.ReadFull(c, b)
+	var r struct {
+		Generation        uint64
+		Transport, Reason string
+		PCM               []byte
+	}
+	if e = json.Unmarshal(b, &r); e != nil {
+		t.Fatal(e)
+	}
+	if r.Generation != 3 || r.Transport != "paused" || r.Reason != "seek" || len(r.PCM) != 0 {
+		t.Fatalf("state read consumed PCM or lost generation: %+v", r)
+	}
+}
