--- /dev/null
+++ b/vorbis/close_lifecycle_test.go
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package vorbis
+
+import (
+	"bytes"
+	"os"
+	"testing"
+
+	librespot "github.com/devgianlu/go-librespot"
+)
+
+func TestActualDecoderCloseAfterRead(t *testing.T) {
+	data, err := os.ReadFile("testdata/close-tone.ogg")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 100; i++ {
+		d, err := New(&librespot.NullLogger{}, bytes.NewReader(data), nil, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if d.SampleRate != 44100 || d.Channels != 2 {
+			t.Fatalf("unexpected fixture format: %d/%d", d.SampleRate, d.Channels)
+		}
+		pcm := make([]float32, 1920)
+		n, err := d.Read(pcm)
+		if err != nil || n != len(pcm) {
+			t.Fatalf("read %d: %d %v", i, n, err)
+		}
+		nonzero := false
+		for _, v := range pcm {
+			if v != 0 {
+				nonzero = true
+				break
+			}
+		}
+		if !nonzero {
+			t.Fatal("fixture decoded only silence")
+		}
+		d.Close()
+		d.Close()
+		if n, err := d.Read(pcm); n != 0 || err == nil {
+			t.Fatalf("read after close: %d %v", n, err)
+		}
+	}
+}
+
+func TestActualDecoderCloseBeforeRead(t *testing.T) {
+	data, err := os.ReadFile("testdata/close-tone.ogg")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 100; i++ {
+		d, err := New(&librespot.NullLogger{}, bytes.NewReader(data), nil, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// DSP exists but no block has been initialized by Read yet.
+		d.Close()
+		d.Close()
+	}
+}
+
+func TestActualDecoderHeaderFailureCleanup(t *testing.T) {
+	data, err := os.ReadFile("testdata/close-tone.ogg")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name string
+		data []byte
+	}{
+		{"empty", nil},
+		{"not_ogg", bytes.Repeat([]byte{0x42}, 4096)},
+		// Only the identification page survives; the secondary headers are gone.
+		{"secondary_headers_missing", append(append([]byte(nil), data[:58]...), make([]byte, 4096-58)...)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for i := 0; i < 100; i++ {
+				d, err := New(&librespot.NullLogger{}, bytes.NewReader(tc.data), nil, 1)
+				if err == nil || d != nil {
+					t.Fatal("invalid headers accepted")
+				}
+			}
+		})
+	}
+}
