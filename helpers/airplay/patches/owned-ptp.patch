 extern log_level *loglevel;
 
+/* Modified by Home Sound: each owned daemon generation has a private name
+ * and control port. These options are immutable once threads are started. */
+static char ptp_shm_name[32] = AP2_PTP_SHM_NAME;
+static unsigned ptp_ctrl_port = AP2_PTP_CTRL_PORT;
+static bool ptp_required = false;
+bool ap2_ptp_set_endpoint(const char *name, unsigned port)
+{
+    if (!name || strlen(name) < 5 || strlen(name) > 30 ||
+        strncmp(name, "/hs-", 4) || port < 1024 || port > 65535) return false;
+    for (const char *p = name + 4; *p; p++)
+        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+              (*p >= '0' && *p <= '9') || *p == '-')) return false;
+    strcpy(ptp_shm_name, name);
+    ptp_ctrl_port = port;
+    return true;
+}
+void ap2_ptp_require_shared(void) { ptp_required = true; }
+bool ap2_ptp_shared_required(void) { return ptp_required; }
+
